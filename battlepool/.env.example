# battlepool/.env.example — variables du déploiement
# Ne jamais committer de clé privée réelle. Copier en .env (gitignored) ou
# injecter via Docker secrets (/run/secrets/*) ou variables d'environnement
# du compose.

# --- PINGALA CHAIN (chaîne cible, L1 Avalanche Subnet souveraine) ---
# RPC public de la L1 Pingala (subnet-evm v1.15.1), chainId 99999.
PINGALA_RPC_URL=
PINGALA_CHAIN_ID=99999
# Clé privée du deployer (owner "cold" du contrat Battlepool, jamais en dur
# dans le repo, jamais montée dans le bridge).
PINGALA_DEPLOYER_PK=

# --- Wallets de rôles Pingala (générés à froid, beta) ---
# Clés des rôles "hot" du contrat Battlepool sur Pingala. Le bridge Node ne
# doit recevoir que PINGALA_SIGNER_PK / PINGALA_PAYOUT_PK au besoin — JAMAIS
# la clé owner (PINGALA_DEPLOYER_PK reste hors du bridge).
PINGALA_SIGNER_PK=
PINGALA_PAYOUT_PK=
PINGALA_DEV_PK=

# --- Legacy (conservés pour compat, phase F les découpera) ---
# FUJI_RPC_URL est un nom legacy Avalanche ; ne plus déployer sur fuji/mainnet.
FUJI_RPC_URL=
GAME_WALLET_PK=