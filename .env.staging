# ==========================================
# COMMUNICATIONS INTER-CONTENEURS
# ==========================================

# 1. Laravel vers le Bridge Node.js (Le bridge écoute sur le port 3000)
NODE_WORKER_URL=http://bridge:3000

# 2. Le Bridge Node.js vers Laravel (Le conteneur app écoute sur 8080 en interne)
LARAVEL_API_URL=http://app:8080/api
BACKEND_URL=http://app:8080

# 3. Le Bridge vers le noeud Blockchain (Hardhat écoute sur le port 8545)
FUJI_RPC_URL=http://blockchain:8545
BASE_BET=0.05
