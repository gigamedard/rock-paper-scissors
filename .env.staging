DB_PORT=3306
DB_DATABASE=rock_paper_scissors
DB_USERNAME=root
DB_PASSWORD=***REMOVED*** # <- MODIFIÉ : L'image Docker de MySQL refuse de démarrer sans mot de passe. Il est obligatoire d'en définir un ici.

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis # <- MODIFIÉ : On utilise le nom du service Docker au lieu de 127.0.0.1
