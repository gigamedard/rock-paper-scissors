# Utilisation d'une image Node.js ultra-légère
FROM node:20-alpine

WORKDIR /app

# Copier les fichiers de dépendances de battlepool
COPY battlepool/package.json battlepool/package-lock.json* ./

# Installer les dépendances (hardhat, ethers, etc.)
RUN npm ci

# Copier le reste du dossier battlepool
COPY battlepool/ .

# Rendre le script exécutable
RUN chmod +x entrypoint.sh

# Lancer le script d'entrée (démarre le nœud ET déploie)
CMD ["./entrypoint.sh"]
